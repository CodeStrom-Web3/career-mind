# =============================================================================
# CareerMind AI Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to source control.
# =============================================================================

# --- Database (CockroachDB via PostgreSQL-compatible interface) ---
DATABASE_URL=postgresql+asyncpg://username:password@host:26257/careermind?sslmode=verify-full

# --- JWT Authentication ---
SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AWS / Amazon Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Bedrock Model IDs ---
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Embedding Configuration ---
EMBEDDING_DIMENSIONS=1024

# --- Memory Retrieval ---
TOP_K_MEMORIES=5
MEMORY_DEDUP_THRESHOLD=0.92
